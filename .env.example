# Copy to .env and fill in. Never commit .env (the repo is public).
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
POD_PORT=
BENCH_MODEL=claude-opus-5-5
# ALTA's voice: man (Gavin, the default) or woman (Maya); or `--voice` when starting
BENCH_VOICE=
# any other Cartesia voice id (beats BENCH_VOICE)
CARTESIA_VOICE_ID=
# empty = default input; an index or name from `python -m bench.voice_in --list-devices`; off = no mic
MIC_DEVICE=
# empty = default output; an index or name from `python -m bench.voice_out --list-devices`; off = captions only
SPEAKER_DEVICE=
# 0.6-1.5; empty = normal
BENCH_VOICE_SPEED=
# fast = Opus fast mode: about half the wait per turn, 2x the price (docs/measurements.md); empty = normal
BENCH_SPEED=
# seconds of silence before ALTA says "Mm, let me check." on a student turn; 0 = never
BENCH_FILLER_S=1.5
